# Copy to .env.docker for local Docker Postgres:
#   copy .env.docker.example .env.docker
#
# Start: docker compose --env-file .env.docker up -d

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=dsr_wsr_db
POSTGRES_PORT=5432

# App connection (use with Python scripts on your machine)
DATABASE_URL=postgresql://postgres:change_me_strong_password@localhost:5432/dsr_wsr_db
POSTGRES_HOST=localhost
