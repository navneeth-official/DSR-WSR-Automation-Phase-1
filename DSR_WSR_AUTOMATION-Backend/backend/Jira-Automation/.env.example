# PostgreSQL connection
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/dsr_wsr_db

# Optional: used by scripts/init_db.py when creating the database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dsr_wsr_db

# Primary LLM — Google AI Studio Gemini
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=auto
WSR_LLM_MAX_CALLS_PER_MINUTE=10

# Optional fallback — Azure OpenAI (comment out unless needed)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_MODEL=gpt-4o-mini
# AZURE_OPENAI_VISION_MODEL=gpt-4o

# Optional fallback — standard OpenAI
# OPENAI_API_KEY=sk-your-key-here

# Optional — auto-upload WSR .pptx to cloud storage after generate/sync
# Set CLOUD_UPLOAD_PROVIDER to pick one backend: google_drive | onedrive | sharepoint
# CLOUD_UPLOAD_PROVIDER=onedrive

# ── Microsoft Entra ID / Azure AD (shared by OneDrive and SharePoint) ──────────
# Register an app in Entra ID, then copy Client ID and Tenant ID here.
# AZURE_CLIENT_ID=your-application-client-id
# AZURE_TENANT_ID=your-directory-tenant-id
# AZURE_AUTHORITY=https://login.microsoftonline.com/your-directory-tenant-id

# Client secret — only required for SharePoint (app-only) auth.
# Not needed for personal OneDrive (device-code / delegated flow).
# AZURE_CLIENT_SECRET=your-secret-value
# AZURE_CLIENT_SECRET_ID=your-secret-id

# --- Microsoft OneDrive personal drive (delegated device-code auth) ---
# 1. Register an Entra public-client app; enable public client flows.
# 2. Add delegated permission: Microsoft Graph → Files.ReadWrite
# 3. First-time sign-in: python scripts/upload_ppt_to_onedrive.py output/WSR_....pptx
#    → .msal_token_cache.bin is saved; future uploads reuse the cached token.
# ONEDRIVE_UPLOAD_ENABLED=true
# ONEDRIVE_UPLOAD_FOLDER=WSR

# --- Microsoft SharePoint shared library (app-only, unattended) — REQUIRED for WSR ---
# WSR templates and generated WSR decks are stored ONLY in SharePoint (never in the
# backend folder). Without these settings template upload / WSR generation fail with
# HTTP 503 "SharePoint storage is not configured".
# 1. Add Application permission: Sites.ReadWrite.All (requires admin consent).
# 2. Get SHAREPOINT_SITE_ID from your admin or:
#    GET https://graph.microsoft.com/v1.0/sites/{hostname}:/{site-path}
# 3. Set AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET (above) and:
# SHAREPOINT_SITE_ID=your-sharepoint-site-id
# Decks:               WSR_<start>_<end>[_vN].pptx
# SHAREPOINT_UPLOAD_FOLDER=Shared Documents/WSR
# Templates:           saved under the uploaded file's own name (My Template.pptx + My Template.json)
# SHAREPOINT_TEMPLATE_FOLDER=Shared Documents/WSR Template
# Sidecars (content JSON, preview text, manifest, validation report + annotated PNGs).
# Blank -> "<SHAREPOINT_UPLOAD_FOLDER>/_data":
# SHAREPOINT_DATA_FOLDER=
# SHAREPOINT_DRIVE_ID=   (optional — leave blank for site's default document library)
#
# Local scratch cache (disposable; re-downloaded from SharePoint on demand). Must be
# outside the backend folder. Blank -> <system temp>/dsr-wsr-work.
# WSR_WORK_DIR=/var/tmp/dsr-wsr-work
# Cached files older than this are deleted when the API starts (0 = never).
# WSR_CACHE_MAX_AGE_HOURS=24
#
# Moving existing files from the old output/ folder (one time):
#   python scripts/migrate_output_to_sharepoint.py --dry-run
#   python scripts/migrate_output_to_sharepoint.py

# --- Google Drive (GCP OAuth desktop client) ---
# 1. Enable Drive API in GCP Console
# 2. Create OAuth 2.0 Desktop credentials → save as credentials/google-oauth-client.json
# 3. First-time sign-in: python scripts/upload_ppt_to_google_drive.py output/WSR_....pptx
# GOOGLE_DRIVE_UPLOAD_ENABLED=true
# GOOGLE_DRIVE_UPLOAD_FOLDER=WSR
# GOOGLE_DRIVE_CLIENT_SECRET_FILE=credentials/google-oauth-client.json

# --- WSR slide preview (PPTX → PNG) ---
# auto = COM on Windows; remote URL on Linux if set; else LibreOffice
# Recommended for Ubuntu production (pixel-perfect): remote + Windows render server
# See docs/WSR_SLIDE_PREVIEW.md
# PPT_RENDER_BACKEND=auto
# PPT_RENDER_BACKEND=remote
# PPT_RENDER_REMOTE_URL=http://10.0.0.5:8765
# PPT_RENDER_REMOTE_TOKEN=shared-secret
# PPT_RENDER_REMOTE_TIMEOUT_SEC=300
# PPT_RENDER_BACKEND=libreoffice
# LIBREOFFICE_PATH=/usr/bin/libreoffice
# PDFTOPPM_PATH=/usr/bin/pdftoppm
