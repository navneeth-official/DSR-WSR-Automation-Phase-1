# AWS shared database — copy to .env (do NOT commit .env)
#
# Replace placeholders with values from your AWS admin (RDS endpoint or EC2 public IP).
# URL-encode special characters in passwords for DATABASE_URL (@ → %40).

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@your-db-host.region.rds.amazonaws.com:5432/dsr_wsr_db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_HOST=your-db-host.region.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=dsr_wsr_db

# Optional: require SSL for RDS (recommended)
# Append to DATABASE_URL: ?sslmode=require
