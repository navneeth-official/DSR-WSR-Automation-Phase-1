# PostgreSQL connection
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/dsr_wsr_db

# Optional: used by scripts/init_db.py when creating the database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dsr_wsr_db

# --- LLM provider (titles, accomplishments, vision helpers) ---
# Switch backends without code changes: auto | gemini | azure | openai | bedrock
LLM_PROVIDER=auto
# Optional model override for whatever provider is active:
# LLM_MODEL=gemini-3.5-flash-lite

# Google Gemini (preferred when GEMINI_API_KEY is set and LLM_PROVIDER=auto)
GEMINI_API_KEY=your-gemini-api-key
# Prefer Flash-Lite under demand spikes; fall back if overloaded.
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.8-flash
LLM_RETRY_ATTEMPTS=4
LLM_RETRY_INITIAL_DELAY_S=1.5
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_MODEL=gpt-4o-mini
# Vision layout audit (overlap/spacing) — Azure/OpenAI vision deployments
# AZURE_OPENAI_VISION_MODEL=gpt-4o

# Standard OpenAI
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# AWS Bedrock (requires: pip install boto3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# --- WSR deck generation (scripts/generate_ppt_content.py) ---
# With these set, run:  python scripts/generate_ppt_content.py
# CLI flags override .env when provided.

# Report period (required for generate_ppt_content.py)
WSR_REPORT_START_DATE=2026-04-16
WSR_REPORT_END_DATE=2026-06-15

# Deck builder: v2 (WSR engine, recommended) or v1 (legacy update_delivery_status.py)
WSR_PPT_ENGINE=v2

# Output paths (relative to repo root unless absolute)
WSR_PPT_OUTPUT=output/HEB_Delivery_Status.pptx
WSR_CONTENT_JSON=output/ppt_content.json
WSR_CONTENT_PREVIEW=output/ppt_content_preview.txt

# Optional: only build JSON/preview, skip PowerPoint (true/false)
# WSR_JSON_ONLY=false

# Optional: override template; otherwise newest .pptx in templates/ (or templates/wsr_template.pptx)
# WSR_TEMPLATE_PATH=templates/G10X H-E-B WSR Sustainment 05 June 2026  Generic Template.pptx

# --- Monthly cadence report (scripts/generate_monthly_report.py) ---
# Independent of the weekly WSR settings above. CLI flags override these.
# Preferred: explicit ~1-month window
# MSR_START_DATE=2026-10-01
# MSR_END_DATE=2026-10-31
# Optional cover date (defaults to MSR_END_DATE when start/end are set)
# MSR_MEETING_DATE=2026-10-20
# Which project(s) to include (comma-separated; match DB project_key or project_name).
# Run with --dry-run first to see which projects have data in the period.
# MSR_TRACK_NAME=SM,SP,COST
# MSR_TRACK_NAME=Cost Core Service,Supplier Core
# Optional: otherwise newest .pptx in templates/monthly/
# MSR_TEMPLATE_PATH=templates/monthly/G10X_H-E-B_Pricing cadence Meeting Template.pptx
# MSR_OUTPUT_DIR=output/monthly
# Monthly decks drop the Index slide at build time (prepare_monthly_template_index.py is optional legacy).
# On Windows, delivery slide copies use PowerPoint COM and the deck is re-saved via COM (needs pywin32).
# MSR_SKIP_COM_RESAVE=1  # tests only; skip final PowerPoint re-save
# Text written into {{Status}} and appended to continuation slide titles
# MSR_STATUS_ENDED_LABEL=Ended
# MSR_STATUS_IN_PROGRESS_LABEL=In-Progress
# MSR_CONTINUATION_SUFFIX= (Contd.)
# Jira status -> Completed / In-Review / In-Progress buckets: config/monthly_status_categories.json
# Accomplishments slides (AI summary of Jira stories in the report month)
# Uses the same LLM_PROVIDER client/model as story titles above.
# MSR_ACCOMPLISHMENTS=auto   # auto = on when any LLM provider is configured
# MSR_ACCOMPLISHMENTS=0      # force off (removes template Accomplishments slide)
# MSR_ACCOMPLISHMENTS_MODEL=  # optional: different model only if you need it
# MSR_ACCOMPLISHMENTS_SLIDE_LINES=6
# MSR_ACCOMPLISHMENTS_MAX_COMPLETED=6
# MSR_ACCOMPLISHMENTS_MAX_IN_PROGRESS=4
# MSR_ACCOMPLISHMENTS_MAX_CHARS=220   # post-clean truncate; keep aligned with summarizer prompt
# MSR_ACCOMPLISHMENTS_MAX_STORIES=120
