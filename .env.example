# PostgreSQL connection
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/dsr_wsr_db

# Optional: used by scripts/init_db.py when creating the database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dsr_wsr_db

# Story title generation — use Azure OpenAI (recommended) OR standard OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_MODEL=gpt-4o-mini
# Vision layout audit (overlap/spacing) — use gpt-4o or gpt-4.1 for best results
AZURE_OPENAI_VISION_MODEL=gpt-4o

# Optional fallback if not using Azure:
# OPENAI_API_KEY=sk-your-key-here

# --- WSR deck generation (scripts/generate_ppt_content.py) ---
# With these set, run:  python scripts/generate_ppt_content.py
# CLI flags override .env when provided.

# Report period (required for generate_ppt_content.py)
WSR_REPORT_START_DATE=2026-04-16
WSR_REPORT_END_DATE=2026-06-15

# Deck builder: v2 (WSR engine, recommended) or v1 (legacy update_delivery_status.py)
WSR_PPT_ENGINE=v2

# Output paths (relative to repo root unless absolute)
WSR_PPT_OUTPUT=output/HEB_Delivery_Status.pptx
WSR_CONTENT_JSON=output/ppt_content.json
WSR_CONTENT_PREVIEW=output/ppt_content_preview.txt

# Optional: only build JSON/preview, skip PowerPoint (true/false)
# WSR_JSON_ONLY=false

# Optional: override template; otherwise newest .pptx in templates/ (or templates/wsr_template.pptx)
# WSR_TEMPLATE_PATH=templates/G10X H-E-B WSR Sustainment 05 June 2026  Generic Template.pptx

# --- Monthly cadence report (scripts/generate_monthly_report.py) ---
# Independent of the weekly WSR settings above. CLI flags override these.
# MSR_PROJECT=PRC
# MSR_MEETING_DATE=2026-08-11
# Which project(s) to include in the deck (comma-separated display names or keys).
# Cover uses the first name; the Index slide is not included in the output deck.
# MSR_TRACK_NAME=Cost Core Service
# MSR_TRACK_NAME=Cost Core Service,Pricing Core
# Optional: otherwise newest .pptx in templates/monthly/
# MSR_TEMPLATE_PATH=templates/monthly/G10X_H-E-B_Pricing cadence Meeting Template.pptx
# MSR_OUTPUT_DIR=output/monthly
# Monthly decks drop the Index slide at build time (prepare_monthly_template_index.py is optional legacy).
# On Windows, delivery slide copies use PowerPoint COM and the deck is re-saved via COM (needs pywin32).
# MSR_SKIP_COM_RESAVE=1  # tests only; skip final PowerPoint re-save
# Accomplishments slides (AI summary of Jira stories in the report month)
# Uses the same Azure/OpenAI client and AZURE_OPENAI_MODEL deployment as story titles above.
# MSR_ACCOMPLISHMENTS=auto   # auto = on when AZURE_OPENAI_* or OPENAI_API_KEY is set
# MSR_ACCOMPLISHMENTS=0      # force off (removes template Accomplishments slide)
# MSR_ACCOMPLISHMENTS_MODEL=  # optional: different deployment only if you need it
# MSR_ACCOMPLISHMENTS_SLIDE_LINES=6
# MSR_ACCOMPLISHMENTS_MAX_STORIES=120
